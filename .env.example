# Copy to backend/.env and edit. Everything else is set on the website's Settings page.

# MongoDB connection
MONGO_URL=mongodb://127.0.0.1:27017/acls

# Web site + API port, and the MQTT port the ESP boards connect to
PORT=4000
MQTT_PORT=1883

# Long random string (e.g. `openssl rand -hex 32`). Keeps users logged in across restarts.
JWT_SECRET=change-me

# Optional. LAN IP of this server as the boards see it. Leave empty: the server finds its own
# network address at start. Set it only if this PC has several networks and picks the wrong one.
BROKER_PUBLIC_HOST=

# Password for the first "admin" user (only used when no user exists yet).
# If empty, a random one is printed in the log on first start.
ADMIN_PASSWORD=

# Login session length in hours
SESSION_HOURS=12

# Set to true only when the site is served over HTTPS (e.g. behind a reverse proxy)
COOKIE_SECURE=false
# Set to 1 when behind one reverse proxy, so the audit log records real client IPs
# TRUST_PROXY=1

# Backups (npm run backup)
# BACKUP_DIR=/var/backups/acls
# BACKUP_KEEP_DAYS=30

# ---- Cloud (Render + Vercel + HiveMQ Cloud) ----
# Leave MQTT_URL empty on the school PC: the server then runs its own MQTT broker on MQTT_PORT.
# Set it to use an external broker instead, e.g. a HiveMQ Cloud cluster (TLS on 8883):
# MQTT_URL=mqtts://xxxxxxxx.s1.eu.hivemq.cloud:8883
# The server's own login on that broker
# MQTT_USERNAME=
# MQTT_PASSWORD=
# The login every board uses (baked into the firmware)
# MQTT_DEVICE_USERNAME=
# MQTT_DEVICE_PASSWORD=
# Root certificate the boards check the broker against (PEM text, or a file path). Without it the
# boards still encrypt but cannot tell a fake broker from the real one.
# MQTT_DEVICE_CA=
# Only for a broker with a private certificate: the root the server should trust
# MQTT_CA=
# This server's public https address; boards download WiFi updates from it. On Render it is
# filled in automatically (RENDER_EXTERNAL_URL).
# PUBLIC_URL=https://als-backend.onrender.com
# The website's address(es), comma separated, allowed to use live updates from another address
# CORS_ORIGIN=https://als-frontend.vercel.app
